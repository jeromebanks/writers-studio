# Copy to .env for local development. Never commit .env.
# Only needed to run apps/web or apps/worker against a real database or
# model provider — the default check/test suite needs neither.

DATABASE_URL=postgresql://writers_studio:writers_studio@localhost:5432/writers_studio_dev

# Model provider keys (optional; leave unset to run with providers disabled)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
